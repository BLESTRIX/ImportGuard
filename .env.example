APP_ENV=development
DATABASE_URL=postgresql+psycopg://importguard:local-password@127.0.0.1:5439/importguard
REDIS_URL=redis://127.0.0.1:6389/0
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY=importguard-local
S3_SECRET_KEY=local-storage-password
S3_BUCKET=importguard
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=50000
MAX_COLUMNS=50
BATCH_SIZE=500
LEASE_SECONDS=120
MAX_JOB_ATTEMPTS=5
ENABLE_FAILURE_INJECTION=false
DEMO_SEED_ENABLED=false
